# Copie para .env.production e preencha. Nunca faça commit do .env.production.

# Endereço público (o subdomínio que o proxy da VPS atende)
PUBLIC_URL=https://obras.seudominio.com.br

# Porta local onde o app escuta (só 127.0.0.1). Escolha uma livre na VPS.
APP_PORT=8090

# Banco (interno ao compose)
POSTGRES_USER=obras
POSTGRES_DB=operaia_obras
# gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Assinatura dos logins. Gere com: openssl rand -hex 32
JWT_SECRET=

# Assinatura dos logins e chave que protege as senhas das caixas de e-mail de notas.
# Atenção: se trocar o JWT_SECRET, cada construtora precisa informar a senha do e-mail de novo.

# Intervalo de leitura das caixas de e-mail de notas, em segundos (0 desliga)
MAIL_POLL_SECONDS=120

# Rede Docker do proxy da VPS (Traefik do Easypanel). Veja compose.proxy.yml.
PROXY_NETWORK=legacy-net
